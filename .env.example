# Server-side secret. NEVER expose this as VITE_HF_TOKEN.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxx

# Optional text-to-image endpoint.
# Default:
# https://router.huggingface.co/hf-inference/models/stabilityai/stable-diffusion-3-medium-diffusers
HF_TEXT_ENDPOINT=

# Optional image-to-image/reference-photo endpoint.
# Set this only to an endpoint/provider that supports the image-to-image task.
HF_IMAGE_ENDPOINT=
