# Server-side secret. NEVER expose this as VITE_HF_TOKEN.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxx

# Inference Providers policy: auto, fastest, cheapest, or a specific provider supported by the model.
HF_PROVIDER=auto

# Default text-to-image model. Change only if the selected model is supported by your provider.
HF_TEXT_MODEL=Qwen/Qwen-Image

# Default image+text-to-image model for reference-photo editing.
HF_IMAGE_MODEL=black-forest-labs/FLUX.2-dev

# Optional: keep these only if you later add a custom endpoint/provider integration.
HF_TEXT_ENDPOINT=
HF_IMAGE_ENDPOINT=
